<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.9">
  <model name="product_parts">
    <static>true</static>
    <link name="assembly_feeder">
      <!-- CAD parts are centred on the assembly plate for layout checks. -->
      <visual name="base_1V4">
        <pose>-0.55 0.40 0.0441 0 0 0</pose>
        <geometry><mesh><uri>model://product/1V4_centered.stl</uri></mesh></geometry>
        <material>
          <ambient>0.18 0.58 0.86 1</ambient>
          <diffuse>0.18 0.58 0.86 1</diffuse>
        </material>
      </visual>
      <visual name="insert_3V4">
        <pose>-0.44 0.40 0.042 0 0 0</pose>
        <geometry><mesh><uri>model://product/3V4_centered.stl</uri></mesh></geometry>
        <material>
          <ambient>0.95 0.47 0.16 1</ambient>
          <diffuse>0.95 0.47 0.16 1</diffuse>
        </material>
      </visual>
      <visual name="top_2V4">
        <pose>-0.34 0.40 0.040 0 0 0</pose>
        <geometry><mesh><uri>model://product/2V4_centered.stl</uri></mesh></geometry>
        <material>
          <ambient>0.95 0.78 0.15 1</ambient>
          <diffuse>0.95 0.78 0.15 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>

